<Project Sdk="Microsoft.NET.Sdk">
  <!-- Platform-neutral logic: API contract, validation, config rendering, policy builders.
       No Windows APIs here so that it is unit-tested on every OS. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FilterPhone.Core</RootNamespace>
    <IsTrimmable>false</IsTrimmable>
    <!-- Core is published inside the win-x64 service/app, so its lock file must carry win-x64 assets
         for locked-mode restore + publish to agree. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" />
  </ItemGroup>
  <PropertyGroup>
    <!-- Build-time product settings. Defaults are the values verified in the FilterPhone source
         (app/lib/src/config.dart, server settings); the support e-mail was provided by the product
         owner. Any of these can be overridden at build time (e.g. -p:FpSupportEmail=...). -->
    <FpApiBaseUrl Condition="'$(FpApiBaseUrl)' == ''">https://api.filterphone.com</FpApiBaseUrl>
    <FpSupportWhatsApp Condition="'$(FpSupportWhatsApp)' == ''">972527186881</FpSupportWhatsApp>
    <FpSupportEmail Condition="'$(FpSupportEmail)' == ''">ywldyld@gmail.com</FpSupportEmail>
    <FpChannel Condition="'$(FpChannel)' == ''">development</FpChannel>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="FilterPhone.ApiBaseUrl" Value="$(FpApiBaseUrl)" />
    <AssemblyMetadata Include="FilterPhone.SupportWhatsApp" Value="$(FpSupportWhatsApp)" />
    <AssemblyMetadata Include="FilterPhone.SupportEmail" Value="$(FpSupportEmail)" />
    <AssemblyMetadata Include="FilterPhone.ExpectedCaSha256" Value="$(FpExpectedCaSha256)" />
    <AssemblyMetadata Include="FilterPhone.Channel" Value="$(FpChannel)" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="FilterPhone.Core.Tests" />
    <InternalsVisibleTo Include="FilterPhone.Windows.Tests" />
  </ItemGroup>
</Project>
