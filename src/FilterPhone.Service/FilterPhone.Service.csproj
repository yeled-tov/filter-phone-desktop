<Project Sdk="Microsoft.NET.Sdk">
  <!-- The privileged protection service (LocalSystem). It owns every change to the machine:
       tunnel, kill switch, CA trust and application control. The UI never runs elevated. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RootNamespace>FilterPhone.Service</RootNamespace>
    <AssemblyName>FilterPhone.Service</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SelfContained>true</SelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\FilterPhone.Core\FilterPhone.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="FilterPhone.Windows.Tests" />
  </ItemGroup>
</Project>
