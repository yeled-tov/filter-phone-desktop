<UserControl x:Class="FilterPhone.App.Views.RegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- The phone app's registration form (register_screen.dart): details → level → blocks → summary.
       DataContext: RegistrationViewModel. -->
  <DockPanel>
    <!-- Title and step bar -->
    <StackPanel DockPanel.Dock="Top" Margin="20,10,20,4">
      <DockPanel>
        <Button Style="{StaticResource TextButton}" Command="{Binding BackCommand}" Margin="-8,0,8,0" AutomationProperties.Name="חזרה">
          <Path Data="{StaticResource IconBack}" Style="{StaticResource Icon}" Width="16" Height="16"/>
        </Button>
        <TextBlock Style="{StaticResource CardTitle}" FontSize="18" VerticalAlignment="Center" Text="הצטרפות ל-FilterPhone"/>
      </DockPanel>
      <ItemsControl ItemsSource="{Binding Steps}" Margin="0,12,0,0" Focusable="False">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Rows="1"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="3,0">
              <Border x:Name="Bar" Height="5" CornerRadius="3" Background="{StaticResource Track}"/>
              <TextBlock x:Name="Label" Text="{Binding Title}" FontSize="12" TextAlignment="Center" Margin="0,5,0,0"
                         Foreground="{StaticResource Muted}"/>
            </StackPanel>
            <DataTemplate.Triggers>
              <DataTrigger Binding="{Binding IsReached}" Value="True">
                <Setter TargetName="Bar" Property="Background" Value="{StaticResource Primary}"/>
                <Setter TargetName="Label" Property="Foreground" Value="{StaticResource Primary}"/>
              </DataTrigger>
              <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                <Setter TargetName="Label" Property="FontWeight" Value="Bold"/>
              </DataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <!-- Bottom bar -->
    <Border DockPanel.Dock="Bottom" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="20,12">
      <!-- Like the phone app: "previous" at the start (only after the first step), "next" fills the rest. -->
      <DockPanel MaxWidth="640">
        <Button DockPanel.Dock="Left" Style="{StaticResource OutlinedButton}" Content="הקודם" Command="{Binding BackCommand}"
                Width="200" Margin="0,0,12,0" MinHeight="50" Visibility="{Binding ShowPrevious, Converter={StaticResource Visible}}"/>
        <Button Style="{StaticResource FilledButton}" Command="{Binding NextCommand}" Margin="0" IsDefault="True">
          <TextBlock Text="{Binding NextLabel}" Foreground="White" FontWeight="Bold" FontSize="15"/>
        </Button>
      </DockPanel>
    </Border>

    <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto">
      <StackPanel MaxWidth="640" Margin="20,12,20,20">

        <!-- ============================ 1. details -->
        <StackPanel Visibility="{Binding IsDetails, Converter={StaticResource Visible}}">
          <TextBlock Style="{StaticResource Title}" Text="הפרטים שלכם"/>
          <TextBlock Style="{StaticResource Hint}" FontSize="14" Margin="0,4,0,14" Text="כדי שנוכל לחזור אליכם ולפתוח את החיבור."/>
          <Border Style="{StaticResource CardBorder}">
            <StackPanel>
              <TextBlock Style="{StaticResource FieldLabel}" Text="שם מלא"/>
              <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" AutomationProperties.Name="שם מלא"/>
              <TextBlock Style="{StaticResource FieldLabel}" Text="טלפון"/>
              <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" MaxLength="30" FlowDirection="LeftToRight"
                       TextAlignment="Right" AutomationProperties.Name="טלפון"/>
              <TextBlock Style="{StaticResource FieldLabel}" Text="מייל (לא חובה)"/>
              <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" FlowDirection="LeftToRight"
                       TextAlignment="Right" AutomationProperties.Name="מייל"/>
              <TextBlock Style="{StaticResource FieldLabel}" Text="שם המחשב (לא חובה)"/>
              <TextBox Text="{Binding DeviceName, UpdateSourceTrigger=PropertyChanged}" MaxLength="60" Margin="0,6,0,4"
                       AutomationProperties.Name="שם המחשב"/>
              <TextBlock Style="{StaticResource Hint}" Margin="2,0" Text="למשל: המחשב בסלון"/>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- catalog loading / failed -->
        <Border Style="{StaticResource CardBorder}" Visibility="{Binding ShowCatalogWait, Converter={StaticResource Visible}}">
          <StackPanel>
            <TextBlock Text="{Binding CatalogWaitText}" TextAlignment="Center" Margin="0,6"/>
            <Button Content="נסו שוב" Command="{Binding RetryCommand}" HorizontalAlignment="Center" Margin="0,8,0,0"
                    Visibility="{Binding CatalogFailed, Converter={StaticResource Visible}}"/>
          </StackPanel>
        </Border>

        <!-- ============================ 2. level -->
        <StackPanel Visibility="{Binding IsLevel, Converter={StaticResource Visible}}">
          <TextBlock Style="{StaticResource Title}" Text="איזו רמת סינון תמונות?"/>
          <TextBlock Style="{StaticResource Hint}" FontSize="14" Margin="0,4,0,14"
                     Text="בחרו את הרמה שמתאימה לכם. הרמה נקבעת סופית על ידי המנהל, ורק הוא יכול לשנות אותה."/>
          <ItemsControl ItemsSource="{Binding Levels}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <RadioButton Style="{StaticResource LevelCard}" GroupName="level" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                             AutomationProperties.Name="{Binding Title}">
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Navy}"/>
                    <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" Margin="0,3,0,0"/>
                    <TextBlock Style="{StaticResource Hint}" Text="{Binding Description}" Margin="0,4,0,0"
                               Visibility="{Binding HasDescription, Converter={StaticResource Visible}}"/>
                  </StackPanel>
                </RadioButton>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- ============================ 3. blocks -->
        <StackPanel Visibility="{Binding IsBlocks, Converter={StaticResource Visible}}">
          <TextBlock Style="{StaticResource Title}" Text="מה עוד לחסום?"/>
          <TextBlock Style="{StaticResource Hint}" FontSize="14" Margin="0,4,0,14"
                     Text="מעבר לסינון התמונות: רשתות חברתיות, אתרים ועוד. אפשר לדלג."/>
          <Border Style="{StaticResource AccentCard}" Padding="16,14,16,8">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource IconStar}" Style="{StaticResource Icon}" Fill="{StaticResource Accent}" Stroke="#D9A300"
                      StrokeThickness="1" Width="20" Height="20" Margin="0,0,8,0"/>
                <TextBlock Style="{StaticResource CardTitle}" Text="הכי מבוקשים"/>
              </StackPanel>
              <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,10" Text="לחיצה אחת — וזה מסומן. אפשר לסמן כמה שרוצים."/>
              <ItemsControl ItemsSource="{Binding Popular}" Focusable="False">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Content="{Binding Title}"
                                  AutomationProperties.Name="{Binding Title}"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <ItemsControl ItemsSource="{Binding Categories}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Expander Style="{StaticResource CategoryCard}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                  <Expander.Header>
                    <StackPanel>
                      <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Navy}"/>
                      <TextBlock Style="{StaticResource Hint}" Text="{Binding CountText}" Margin="0,2,0,0"/>
                    </StackPanel>
                  </Expander.Header>
                  <ItemsControl ItemsSource="{Binding Options}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <CheckBox Style="{StaticResource OptionCheck}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                  AutomationProperties.Name="{Binding Title}">
                          <StackPanel>
                            <TextBlock Text="{Binding Title}" FontSize="14"/>
                            <TextBlock Style="{StaticResource Hint}" Text="{Binding Description}"
                                       Visibility="{Binding HasDescription, Converter={StaticResource Visible}}"/>
                            <TextBlock Text="{Binding Warning}" FontSize="13" Foreground="{StaticResource Bad}"
                                       Visibility="{Binding HasWarning, Converter={StaticResource Visible}}"/>
                          </StackPanel>
                        </CheckBox>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Expander>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Style="{StaticResource FieldLabel}" Text="משהו נוסף? (לא חובה)" Margin="2,12,2,0"/>
          <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="96"
                   MaxLength="1500" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="משהו נוסף"/>
          <TextBlock Style="{StaticResource Hint}" Margin="2,-8,2,0" Text="אתר מסוים לחסום, תוכנה, בקשה מיוחדת…"/>
        </StackPanel>

        <!-- ============================ 4. summary -->
        <StackPanel Visibility="{Binding IsSummary, Converter={StaticResource Visible}}">
          <TextBlock Style="{StaticResource Title}" Text="הכול נכון?"/>
          <TextBlock Style="{StaticResource Hint}" FontSize="14" Margin="0,4,0,14" Text="אפשר לחזור ולשנות לפני השליחה."/>
          <Border Style="{StaticResource CardBorder}" Padding="6">
            <StackPanel>
              <DockPanel Margin="12,10">
                <Button DockPanel.Dock="Right" Style="{StaticResource TextButton}" Content="עריכה" Command="{Binding EditDetailsCommand}"/>
                <Path Data="{StaticResource IconPerson}" Style="{StaticResource Icon}" Margin="0,0,12,0" VerticalAlignment="Top"/>
                <StackPanel>
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding Phone}" Foreground="{StaticResource Muted}"/>
                  <TextBlock Text="{Binding Email}" Foreground="{StaticResource Muted}" Visibility="{Binding HasEmail, Converter={StaticResource Visible}}"/>
                  <TextBlock Text="{Binding DeviceNameShown}" Foreground="{StaticResource Muted}"/>
                </StackPanel>
              </DockPanel>
              <Border Height="1" Background="{StaticResource Line}" Margin="12,0"/>
              <DockPanel Margin="12,10">
                <Button DockPanel.Dock="Right" Style="{StaticResource TextButton}" Content="עריכה" Command="{Binding EditLevelCommand}"/>
                <Path Data="{StaticResource IconTune}" Style="{StaticResource Icon}" Margin="0,0,12,0" VerticalAlignment="Top"/>
                <StackPanel>
                  <TextBlock Text="רמת סינון" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding LevelSummary}" Foreground="{StaticResource Muted}"/>
                </StackPanel>
              </DockPanel>
              <Border Height="1" Background="{StaticResource Line}" Margin="12,0"/>
              <DockPanel Margin="12,10">
                <Button DockPanel.Dock="Right" Style="{StaticResource TextButton}" Content="עריכה" Command="{Binding EditBlocksCommand}"/>
                <Path Data="{StaticResource IconBlock}" Style="{StaticResource Icon}" Margin="0,0,12,0" VerticalAlignment="Top"/>
                <StackPanel>
                  <TextBlock Text="חסימות" FontWeight="SemiBold"/>
                  <TextBlock Text="רק סינון תמונות ואתרים" Foreground="{StaticResource Muted}"
                             Visibility="{Binding HasNoBlocks, Converter={StaticResource Visible}}"/>
                  <ItemsControl ItemsSource="{Binding SelectedTitles}" Margin="0,6,0,0" Focusable="False">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Background="{StaticResource PrimaryContainer}" CornerRadius="12" Padding="10,4" Margin="0,0,6,6">
                          <TextBlock Text="{Binding}" FontSize="13" Foreground="{StaticResource Navy}"/>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DockPanel>
              <StackPanel Visibility="{Binding HasNote, Converter={StaticResource Visible}}">
                <Border Height="1" Background="{StaticResource Line}" Margin="12,0"/>
                <DockPanel Margin="12,10">
                  <Path Data="{StaticResource IconNote}" Style="{StaticResource Icon}" Margin="0,0,12,0" VerticalAlignment="Top"/>
                  <StackPanel>
                    <TextBlock Text="הערות" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Note}" Foreground="{StaticResource Muted}"/>
                  </StackPanel>
                </DockPanel>
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource AccentCard}">
            <StackPanel>
              <TextBlock Style="{StaticResource CardTitle}" Text="מה קורה אחרי השליחה?" Margin="0,0,0,8"/>
              <TextBlock Text="1. הבקשה מגיעה אלינו עם כל מה שבחרתם."/>
              <TextBlock Text="2. נחזור אליכם להסדרת התשלום."/>
              <TextBlock Text="3. אחרי האישור החיבור נפתח — והמחשב מתחבר לבד וחסימת הגלישה מופעלת."/>
            </StackPanel>
          </Border>
        </StackPanel>

        <Border Style="{StaticResource ErrorCard}" Visibility="{Binding HasError, Converter={StaticResource Visible}}">
          <TextBlock Text="{Binding Error}" Foreground="{StaticResource Bad}" FontWeight="SemiBold" AutomationProperties.LiveSetting="Assertive"/>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
