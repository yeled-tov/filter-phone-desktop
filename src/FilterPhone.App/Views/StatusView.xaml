<UserControl x:Class="FilterPhone.App.Views.StatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- An activated PC: verified protection state, support and about. DataContext: MainViewModel. -->
  <TabControl Background="Transparent" BorderThickness="0" Padding="0" Margin="16,10,16,0">
    <TabControl.Resources>
      <Style TargetType="TabItem" BasedOn="{StaticResource PillTab}"/>
    </TabControl.Resources>

    <!-- ============================================== protection -->
    <TabItem Header="_מצב ההגנה" AutomationProperties.Name="מצב ההגנה">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="680" Margin="0,12,0,12">
          <Border Style="{StaticResource CardBorder}" Background="{StaticResource HeroGradient}" Padding="20,22">
            <StackPanel>
              <Grid Width="76" Height="76" HorizontalAlignment="Center">
                <Ellipse Fill="{Binding StateTint}"/>
                <Path Data="{Binding StateIcon}" Style="{StaticResource Icon}" Stroke="{Binding StateColor}" Width="42" Height="42" StrokeThickness="2.2"/>
              </Grid>
              <TextBlock Style="{StaticResource Title}" TextAlignment="Center" Margin="0,12,0,4" Text="{Binding StateTitle}"
                         Foreground="{Binding StateColor}" AutomationProperties.LiveSetting="Polite"/>
              <TextBlock TextAlignment="Center" FontSize="15" Text="{Binding LevelLine}" Margin="0,0,0,6"/>
              <TextBlock TextAlignment="Center" Text="{Binding StateExplanation}"/>
              <TextBlock TextAlignment="Center" Margin="0,6,0,0" Text="{Binding ServerMessage}"
                         Visibility="{Binding HasServerMessage, Converter={StaticResource Visible}}"/>
              <TextBlock Style="{StaticResource Hint}" TextAlignment="Center" Margin="0,10,0,0" Text="{Binding LastVerified}"/>
              <TextBlock Style="{StaticResource Hint}" TextAlignment="Center" Text="{Binding DeviceLine}"/>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CardBorder}">
            <StackPanel>
              <TextBlock Style="{StaticResource CardTitle}" Margin="0,0,0,8" Text="שכבות ההגנה — כל אחת נבדקת בנפרד"/>
              <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,7" AutomationProperties.Name="{Binding Accessible}" Focusable="True">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <Ellipse Width="11" Height="11" Fill="{Binding Color}" VerticalAlignment="Top" Margin="0,5,12,0"/>
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Name}"/>
                        <TextBlock Style="{StaticResource Hint}" Text="{Binding Detail}" Visibility="{Binding HasDetail, Converter={StaticResource Visible}}"/>
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="{Binding State}" Foreground="{Binding Color}" FontWeight="SemiBold" Margin="12,0,0,0"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <WrapPanel>
            <Button Style="{StaticResource FilledButton}" MinHeight="44" Margin="0,0,10,8" Command="{Binding VerifyCommand}">
              <TextBlock Text="בדיקת סינון התמונות עכשיו" Foreground="White" FontWeight="Bold"/>
            </Button>
            <Button Content="חיבור מחדש" Command="{Binding ReconnectCommand}"/>
            <Button Content="ייצוא דוח אבחון" Command="{Binding ExportCommand}"/>
          </WrapPanel>
          <TextBlock Margin="2,6,2,0" Text="{Binding Message}" Visibility="{Binding HasMessage, Converter={StaticResource Visible}}"
                     AutomationProperties.LiveSetting="Polite" FontWeight="SemiBold"/>
        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <!-- ============================================== support -->
    <TabItem Header="_תמיכה" AutomationProperties.Name="תמיכה">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="680" Margin="0,12,0,12">
          <Border Style="{StaticResource CardBorder}">
            <StackPanel>
              <TextBlock Style="{StaticResource Title}" Text="פנייה לתמיכה"/>
              <TextBlock Margin="0,8,0,4">
                <Run Text="מספר התמיכה בוואטסאפ: "/><Run Text="{Binding SupportNumberDisplay, Mode=OneWay}" FontWeight="SemiBold"/>
              </TextBlock>
              <TextBlock Style="{StaticResource Hint}" Text="{Binding WhatsAppState}"/>
              <TextBlock Style="{StaticResource Hint}" Text="{Binding EmailNote}" Margin="0,0,0,12"/>
              <TextBlock Style="{StaticResource FieldLabel}" Text="ההודעה (אפשר לערוך)"/>
              <TextBox Text="{Binding SupportMessage, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                       TextWrapping="Wrap" MinHeight="120" MaxLength="1500" VerticalScrollBarVisibility="Auto"
                       AutomationProperties.Name="הודעה לתמיכה"/>
              <CheckBox IsChecked="{Binding AttachReport}" Margin="-10,0,0,10">
                <TextBlock Text="לשמור גם דוח אבחון (בלי קוד הפעלה, מפתחות או היסטוריית גלישה) כדי שאצרף אותו בעצמי"/>
              </CheckBox>
              <WrapPanel>
                <Button Style="{StaticResource FilledButton}" MinHeight="44" Margin="0,0,10,8" Command="{Binding WhatsAppCommand}">
                  <TextBlock Text="פתיחת WhatsApp עם ההודעה" Foreground="White" FontWeight="Bold"/>
                </Button>
                <Button Content="שליחה במייל" Command="{Binding EmailCommand}"/>
              </WrapPanel>
              <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                         Text="שום הודעה לא נשלחת אוטומטית: WhatsApp או תוכנת הדואר נפתחים עם הטקסט, ואתם בוחרים אם לשלוח."/>
            </StackPanel>
          </Border>
          <TextBlock Margin="2,6,2,0" Text="{Binding Message}" Visibility="{Binding HasMessage, Converter={StaticResource Visible}}"/>
        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <!-- ============================================== about -->
    <TabItem Header="_אודות" AutomationProperties.Name="אודות">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="680" Margin="0,12,0,12">
          <Border Style="{StaticResource CardBorder}">
            <StackPanel>
              <TextBlock Style="{StaticResource Title}" Text="FilterPhone למחשב"/>
              <TextBlock Margin="0,6,0,0" Text="{Binding Version}"/>
              <TextBlock Style="{StaticResource Hint}" Text="{Binding WindowsLine}"/>
              <WrapPanel Margin="0,12,0,0">
                <Button Content="בדיקת עדכונים" Command="{Binding UpdateCommand}"/>
              </WrapPanel>
              <TextBlock Style="{StaticResource Hint}" Text="{Binding UpdateState}"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource CardBorder}">
            <StackPanel>
              <TextBlock Style="{StaticResource CardTitle}" Text="פרטיות"/>
              <TextBlock Margin="0,6,0,0" Text="הגלישה עוברת דרך שרת הסינון של FilterPhone כדי לסנן אתרים ותמונות, כמו באפליקציה לטלפון. התוכנה במחשב לא אוספת ולא שולחת סיסמאות, היסטוריית גלישה, תוכן דפים או קבצים. לשרת נשלח דיווח טכני קצר: מצב החיבור, גרסת התוכנה ותוצאות הבדיקות."/>
              <TextBlock Margin="0,8,0,0" Text="רכיבים: WireGuard for Windows (WireGuard LLC), ‏.NET (Microsoft), ‏BouncyCastle. הרישיונות נמצאים בקובץ THIRD-PARTY-NOTICES.txt בתיקיית ההתקנה."/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </TabItem>
  </TabControl>
</UserControl>
