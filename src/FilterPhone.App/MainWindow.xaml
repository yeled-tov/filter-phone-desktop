<Window x:Class="FilterPhone.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:FilterPhone.App.Views"
        Title="FilterPhone למחשב"
        Icon="Assets/filterphone.ico"
        FlowDirection="RightToLeft"
        Language="he-IL"
        FontFamily="Segoe UI"
        Foreground="{StaticResource Ink}"
        Width="760" Height="860" MinWidth="560" MinHeight="600"
        Background="{StaticResource Page}"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <DockPanel x:Name="Root">
    <!-- App bar, like the phone app: white, navy title, FilterPhone shield. -->
    <Border DockPanel.Dock="Top" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="20,12">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Hint}" VerticalAlignment="Center" Text="{Binding Version}"/>
        <StackPanel Orientation="Horizontal">
          <Grid Width="38" Height="38">
            <Ellipse Fill="{StaticResource PrimaryContainer}"/>
            <Path Data="{StaticResource IconShield}" Style="{StaticResource Icon}" Width="22" Height="22" StrokeThickness="2"/>
          </Grid>
          <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" FontSize="19" FontWeight="Bold" Foreground="{StaticResource Navy}"
                     Text="FilterPhone למחשב"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid>
      <!-- The protection service does not answer. -->
      <Border Style="{StaticResource ErrorCard}" Margin="20" VerticalAlignment="Top"
              Visibility="{Binding ServiceUnreachable, Converter={StaticResource Visible}}">
        <TextBlock Text="{Binding ServiceProblem}" Foreground="{StaticResource Bad}" FontWeight="SemiBold"/>
      </Border>
      <TextBlock Style="{StaticResource Hint}" Text="מתחבר לשירות ההגנה…" HorizontalAlignment="Center" VerticalAlignment="Center"
                 Visibility="{Binding ShowLoading, Converter={StaticResource Visible}}"/>
      <v:WelcomeView Visibility="{Binding ShowWelcome, Converter={StaticResource Visible}}"/>
      <Border Visibility="{Binding ShowRegister, Converter={StaticResource Visible}}">
        <v:RegisterView DataContext="{Binding Registration}"/>
      </Border>
      <v:ActivationView Visibility="{Binding ShowActivation, Converter={StaticResource Visible}}"/>
      <v:PendingView Visibility="{Binding ShowPending, Converter={StaticResource Visible}}"/>
      <v:StatusView Visibility="{Binding ShowStatus, Converter={StaticResource Visible}}"/>
    </Grid>
  </DockPanel>
</Window>
